# Local: no database or provider credentials required. Never commit real values.
# ECHO_DATA_DIR=.data/postgres
# Managed production: configure these securely in your hosting provider.
# DATABASE_URL=
# APP_ORIGIN=https://your-echo-domain.example
# ALLOW_REGISTRATION=false
# Configure only models you have verified are available to your API account.
# ECHO_OPENAI_API_KEY=
# ECHO_OPENAI_MODEL=
# ECHO_ANTHROPIC_API_KEY=
# ECHO_ANTHROPIC_MODEL=
# ECHO_EMBEDDING_MODEL=text-embedding-3-small
# DAILY_TOKEN_LIMIT=100000
# For a single-server production-mode evaluation with a persistent volume only:
# ECHO_ALLOW_LOCAL_DB=1
# CHROMIUM_PATH=/usr/bin/chromium
